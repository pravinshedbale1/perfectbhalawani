rules_version = '2';

// परफेक्ट कॉम्प्युटर्स — Firestore सुरक्षा नियम
// Firebase Console → Firestore Database → Rules येथे हे पेस्ट करून Publish करा.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    function exerciseOf(exId) {
      return get(/databases/$(database)/documents/exercises/$(exId)).data;
    }
    function me() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    // ---- पहिला Admin (फक्त एकदाच, /setup पानावरून) ----
    match /config/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/bootstrap)
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/config/bootstrap)
            && existsAfter(/databases/$(database)/documents/config/bootstrap));
      allow update, delete: if isAdmin();
    }

    // ---- सार्वजनिक सूचना फलक ----
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- पावती क्रमांक इ. ----
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    match /batches/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // विद्यार्थ्याचा सध्याचा पासवर्ड — फक्त Admin वाचू शकतो (पासवर्ड रीसेटसाठी).
    // विद्यार्थी स्वतःचा पासवर्ड बदलल्यावर फक्त अद्ययावत करू शकतो (वाचू शकत नाही).
    match /studentLogins/{uid} {
      allow read, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.loginId == resource.data.loginId
            && request.resource.data.keys().hasOnly(['loginId', 'password', 'updatedAt']));
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // अभ्यासक्रम व मॉड्यूल्सची नावे सार्वजनिक (मुख्यपृष्ठावर अभ्यासक्रम दाखवण्यासाठी)
    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /modules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // submissions/{studentUid}_{exerciseId}
    match /submissions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent() && me().active != false
        && id == request.auth.uid + '_' + request.resource.data.exerciseId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.batchId == me().batchId
        && request.resource.data.status == 'submitted'
        && !('marks' in request.resource.data);

      // मूल्यांकन झाल्यावर विद्यार्थी बदल करू शकत नाही (Admin ने 'redo' केल्यास पुन्हा करू शकतो)
      allow update: if isStudent() && me().active != false
        && resource.data.studentId == request.auth.uid
        && resource.data.status != 'evaluated'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.exerciseId == resource.data.exerciseId
        && request.resource.data.batchId == me().batchId
        && request.resource.data.status == 'submitted'
        && request.resource.data.get('marks', null) == resource.data.get('marks', null);

      // पोर्टलवरील सराव: सादर करताच आपोआप गुण (प्रश्नमंजुषेप्रमाणे) — फक्त पोर्टल प्रकारांसाठी, कमाल गुणांपर्यंत.
      // Admin ने गुण दिल्यास (auto=false) विद्यार्थी ते बदलू शकत नाही.
      allow create, update: if isStudent() && me().active != false
        && id == request.auth.uid + '_' + request.resource.data.exerciseId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.batchId == me().batchId
        && request.resource.data.status == 'evaluated'
        && request.resource.data.auto == true
        && exerciseOf(request.resource.data.exerciseId).get('kind', 'upload') in ['keys', 'typing', 'letter', 'writer', 'calc', 'impress', 'statement', 'email', 'mcq']
        && request.resource.data.maxMarks == exerciseOf(request.resource.data.exerciseId).get('maxMarks', 10)
        && request.resource.data.marks is number
        && request.resource.data.marks >= 0
        && request.resource.data.marks <= request.resource.data.maxMarks
        && (resource == null || (resource.data.studentId == request.auth.uid
            && (resource.data.status != 'evaluated' || resource.data.get('auto', false) == true)));

      allow write: if isAdmin();
    }

    // थेट लीडरबोर्ड: प्रत्येक विद्यार्थ्याची ओळ. विद्यार्थी फक्त स्वतःची ओळ लिहू शकतो; फक्त स्वतःच्या बॅचच्या ओळी वाचू शकतो.
    match /boardRows/{uid} {
      allow read: if isAdmin() || (isStudent() && resource.data.batchId == me().batchId);
      allow write: if isAdmin();
      allow create, update: if isStudent() && request.auth.uid == uid && me().active != false
        && request.resource.data.batchId == me().batchId
        && request.resource.data.keys().hasOnly(['batchId', 'name', 'total', 'max', 'evaluated', 'submitted', 'updatedAt'])
        && request.resource.data.total is number && request.resource.data.max is number
        && request.resource.data.total >= 0 && request.resource.data.total <= request.resource.data.max;
    }

    // LibreOffice सरावाच्या फाइल्स (submissions पासून वेगळ्या — यादी हलकी राहण्यासाठी)
    match /submissionFiles/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if isAdmin() || (isStudent() && me().active != false
        && id == request.auth.uid + '_' + request.resource.data.exerciseId
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['studentId', 'batchId', 'exerciseId', 'file', 'ext', 'size', 'at']));
      allow delete: if isAdmin();
    }

    // Admin ने LibreOffice मध्ये बनवलेले संदर्भ (नमुना) — सर्व लॉगिन वापरकर्ते वाचू शकतात
    match /exerciseFiles/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // leaderboards/{batchId} — Admin गुण दिल्यावर अद्ययावत होते
    match /leaderboards/{batchId} {
      allow read: if isAdmin() || (isStudent() && me().batchId == batchId);
      allow write: if isAdmin();
    }
  }
}
